<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeckToolBox.App.Framework.ViewModels"
             xmlns:ctl="using:DeckToolBox.App.Framework.Controls"
             x:Class="DeckToolBox.App.Framework.Views.ModuleContentView"
             x:DataType="vm:ModuleViewModel">

    <UserControl.Resources>
        <!-- 段落列表：每个字符串一段，支持 **加粗** / `代码` / 列表缩进 -->
        <DataTemplate x:Key="Paragraph" x:DataType="x:String">
            <TextBlock Classes="Body" ctl:RichText.Markup="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="32,22,28,32" MaxWidth="1100">

            <!-- 页头 -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Breadcrumb}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <Border Classes="Chip"><TextBlock Text="{Binding LevelLabel}" /></Border>
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Keywords}" FontSize="12" Foreground="{StaticResource Accent}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                <TextBlock Classes="Body" ctl:RichText.Markup="{Binding Overview}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 1. 原理 -->
            <Border Classes="Section Why" IsVisible="{Binding HasWhy}">
                <StackPanel>
                    <TextBlock Classes="SectionTitle" Text="📌 原理：为什么是这样" Foreground="{StaticResource Accent}" />
                    <ItemsControl ItemsSource="{Binding Why}" ItemTemplate="{StaticResource Paragraph}" />
                </StackPanel>
            </Border>

            <!-- 2. 后果与边界 -->
            <Border Classes="Section Consequence" IsVisible="{Binding HasConsequences}">
                <StackPanel>
                    <TextBlock Classes="SectionTitle" Text="⚠️ 后果与边界" Foreground="{StaticResource Amber}" />
                    <ItemsControl ItemsSource="{Binding Consequences}" ItemTemplate="{StaticResource Paragraph}" />
                </StackPanel>
            </Border>

            <!-- 3. 操作步骤 -->
            <Border Classes="Section" IsVisible="{Binding HasSteps}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="SectionTitle" Text="💻 操作步骤" Foreground="{StaticResource TextStrong}" Margin="0" />
                    <TextBlock Text="复制后粘贴到 Konsole 终端执行。「▶ 执行后」说明运行后会看到什么、改变了什么；标签说明风险等级；标注了执行位置的指令不要在本机终端直接运行。"
                               FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StepViewModel">
                                <StackPanel Spacing="6" Margin="0,8,0,8">
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource Bg3}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBody}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextStrong}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                        <Border Classes="Chip" Classes.Read="{Binding IsRead}" Classes.Change="{Binding IsChange}"
                                                Classes.Root="{Binding IsRoot}" Classes.Danger="{Binding IsDanger}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding RiskLabel}" />
                                        </Border>
                                        <Border Classes="Chip Host" IsVisible="{Binding HasHost}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding HostLabel}" />
                                        </Border>
                                        <Border Classes="Chip" IsVisible="{Binding HasPlaceholder}">
                                            <TextBlock Text="含 &lt;占位符&gt;，先替换再执行" />
                                        </Border>
                                    </WrapPanel>

                                    <Border Classes="CodeBox" Classes.Root="{Binding IsRoot}" Classes.Danger="{Binding IsDanger}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <SelectableTextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                                 Foreground="{StaticResource CodeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="Copy" Content="复制" Command="{Binding CopyCommand}" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Classes="Body" FontSize="13" Foreground="{StaticResource TextMuted}"
                                               ctl:RichText.Markup="{Binding Note}" IsVisible="{Binding HasNote}" />

                                    <!-- 执行后会发生什么 -->
                                    <Border Classes="Outcome" IsVisible="{Binding HasOutcome}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="▶ 执行后" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Green}"
                                                       Margin="0,2,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Classes="Body" FontSize="13"
                                                       ctl:RichText.Markup="{Binding Outcome}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. 验证 -->
            <Border Classes="Section Verify" IsVisible="{Binding HasVerify}">
                <StackPanel>
                    <TextBlock Classes="SectionTitle" Text="🔍 如何验证" Foreground="{StaticResource Green}" />
                    <ItemsControl ItemsSource="{Binding Verify}" ItemTemplate="{StaticResource Paragraph}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
