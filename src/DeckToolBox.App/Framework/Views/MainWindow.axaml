<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeckToolBox.App.Framework.ViewModels"
        xmlns:views="using:DeckToolBox.App.Framework.Views"
        x:Class="DeckToolBox.App.Framework.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeckToolBox · Linux 使用手册"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶栏：标识 + 专区切换 -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#238636" CornerRadius="6" Width="34" Height="34">
                        <TextBlock Text="🧰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DeckToolBox" FontWeight="ExtraBold" FontSize="16" Foreground="{StaticResource TextStrong}" />
                        <TextBlock Text="看懂原理 · 看清后果 · 亲手执行" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource Bg3}" CornerRadius="8" Padding="3"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ScopeTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScopeTabViewModel">
                                <Button Classes="ScopeTab" Classes.Active="{Binding IsActive}" Command="{Binding SelectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Icon}" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}"
                           Text="{Binding ModuleCount, StringFormat='{}{0} 个模块'}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,*">

            <!-- 左侧：搜索 + 目录 -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="14,14,14,8" Spacing="8">
                        <TextBox x:Name="SearchBox" Classes="Search"
                                 Text="{Binding SearchText}"
                                 Watermark="🔍 搜索模块或命令（Ctrl+F）" />
                        <TextBlock Text="{Binding ActiveScope.Tagline}" IsVisible="{Binding !IsSearching}"
                                   FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SearchSummary}" IsVisible="{Binding IsSearching}"
                                   FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 目录 -->
                    <ScrollViewer x:Name="NavScroll" Grid.Row="1" IsVisible="{Binding !IsSearching}">
                        <ItemsControl ItemsSource="{Binding NavCategories}" Margin="8,0,10,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavCategoryViewModel">
                                    <StackPanel Margin="0,8,0,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,4" ToolTip.Tip="{Binding Description}">
                                            <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Modules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavModuleViewModel">
                                                    <Button Classes="NavItem" Classes.Selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Keywords}" FontSize="11"
                                                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Classes="Chip" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding LevelLabel}" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 搜索结果（跨全部专区） -->
                    <ScrollViewer x:Name="SearchScroll" Grid.Row="1" IsVisible="{Binding IsSearching}">
                        <ItemsControl ItemsSource="{Binding SearchResults}" Margin="8,0,10,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavModuleViewModel">
                                    <Button Classes="NavItem" Classes.Selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Location}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧：模块内容 -->
            <views:ModuleContentView Grid.Column="1" DataContext="{Binding CurrentModule}" />
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="Chip Read"><TextBlock Text="只读" /></Border>
                    <Border Classes="Chip Change"><TextBlock Text="修改用户数据" /></Border>
                    <Border Classes="Chip Root"><TextBlock Text="需要 sudo" /></Border>
                    <Border Classes="Chip Danger"><TextBlock Text="高危" /></Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
