<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeckToolBox.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- 调色板（GitHub Dark 风格），所有视图只引用这里的画刷 -->
        <SolidColorBrush x:Key="Bg0" Color="#0D1117" />
        <SolidColorBrush x:Key="Bg1" Color="#161B22" />
        <SolidColorBrush x:Key="Bg2" Color="#1C2128" />
        <SolidColorBrush x:Key="Bg3" Color="#21262D" />
        <SolidColorBrush x:Key="Line" Color="#30363D" />
        <SolidColorBrush x:Key="TextStrong" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextBody" Color="#C9D1D9" />
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E" />
        <SolidColorBrush x:Key="Accent" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentStrong" Color="#1F6FEB" />
        <SolidColorBrush x:Key="AccentSoft" Color="#1A2B45" />
        <SolidColorBrush x:Key="Green" Color="#3FB950" />
        <SolidColorBrush x:Key="Amber" Color="#D29922" />
        <SolidColorBrush x:Key="Red" Color="#F85149" />
        <SolidColorBrush x:Key="Purple" Color="#BC8CFF" />
        <SolidColorBrush x:Key="CodeText" Color="#79C0FF" />
        <FontFamily x:Key="MonoFont">Cascadia Code, JetBrains Mono, Hack, Noto Sans Mono, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ========== 内容卡片 ========== -->
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="Border.Section.Why"><Setter Property="BorderBrush" Value="{StaticResource AccentStrong}" /></Style>
        <Style Selector="Border.Section.Consequence"><Setter Property="BorderBrush" Value="{StaticResource Amber}" /></Style>
        <Style Selector="Border.Section.Verify"><Setter Property="BorderBrush" Value="#238636" /></Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.Body">
            <Setter Property="Foreground" Value="{StaticResource TextBody}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ========== 小标签 (Chip) ========== -->
        <Style Selector="Border.Chip">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.Chip.Read"><Setter Property="Background" Value="#12261A" /></Style>
        <Style Selector="Border.Chip.Read > TextBlock"><Setter Property="Foreground" Value="{StaticResource Green}" /></Style>
        <Style Selector="Border.Chip.Change"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
        <Style Selector="Border.Chip.Change > TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Style>
        <Style Selector="Border.Chip.Root"><Setter Property="Background" Value="#2E2410" /></Style>
        <Style Selector="Border.Chip.Root > TextBlock"><Setter Property="Foreground" Value="{StaticResource Amber}" /></Style>
        <Style Selector="Border.Chip.Danger"><Setter Property="Background" Value="#3A1618" /></Style>
        <Style Selector="Border.Chip.Danger > TextBlock"><Setter Property="Foreground" Value="{StaticResource Red}" /></Style>
        <Style Selector="Border.Chip.Host"><Setter Property="Background" Value="#261B3A" /></Style>
        <Style Selector="Border.Chip.Host > TextBlock"><Setter Property="Foreground" Value="{StaticResource Purple}" /></Style>

        <!-- ========== 指令代码框 ========== -->
        <Style Selector="Border.CodeBox">
            <Setter Property="Background" Value="{StaticResource Bg0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Border.CodeBox.Danger"><Setter Property="BorderBrush" Value="#6E2B2B" /></Style>
        <Style Selector="Border.CodeBox.Root"><Setter Property="BorderBrush" Value="#5A4A1C" /></Style>

        <Style Selector="Border.Outcome">
            <Setter Property="Background" Value="#0F1F14" />
            <Setter Property="BorderBrush" Value="#1E4D2B" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="CornerRadius" Value="0,4,4,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="Button.Copy">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="Foreground" Value="{StaticResource TextBody}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.Copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="Button.Related">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="Foreground" Value="{StaticResource TextBody}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Related:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <!-- ========== 顶部专区 Tab ========== -->
        <Style Selector="Button.ScopeTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ScopeTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        </Style>
        <Style Selector="Button.ScopeTab.Active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentStrong}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ========== 左侧导航条目 ========== -->
        <Style Selector="Button.NavItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0,6,6,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Bg3}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style Selector="Button.NavItem.Selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="TextBox.Search">
            <Setter Property="Background" Value="{StaticResource Bg0}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Application.Styles>
</Application>
